<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/management_card_shadow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Card Background -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/management_card_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/md_theme_outline_variant" />
        </shape>
    </item>
</layer-list>