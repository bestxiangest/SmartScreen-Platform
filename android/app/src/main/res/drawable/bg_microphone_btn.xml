<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 主背景 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/blue_500"
                android:endColor="@color/blue_600"
                android:angle="135" />
        </shape>
    </item>
    
    <!-- 高光效果 -->
    <item android:top="0dp" android:height="20dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="@android:color/transparent"
                android:angle="90" />
        </shape>
    </item>
    
    <!-- 边框 -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/blue_700" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- 内圈装饰 -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/white" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
</layer-list>