<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/base_intro_card_hover">
    
    <item android:id="@android:id/background">
        <layer-list>
            <!-- 外层阴影 -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="8dp">
                <shape android:shape="rectangle">
                    <solid android:color="#08000000" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            
            <!-- 中层阴影 -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#12000000" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            
            <!-- 主卡片层 -->
            <item android:top="0dp" android:left="0dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/base_intro_card_bg"
                        android:endColor="#FAFAFA"
                        android:angle="135"
                        android:type="linear" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="0.8dp"
                        android:color="#E0E0E0" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 悬停状态遮罩 -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
</ripple>