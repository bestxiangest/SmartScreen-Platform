<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 卡片头部 -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- 主题图标 -->
            <ImageView
                android:id="@+id/iv_theme_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_culture_theme" />

            <!-- 标题 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_theme_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/culture_theme_4_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/culture_theme_amber" />

            </LinearLayout>

            <!-- 展开/收起图标 -->
            <ImageView
                android:id="@+id/iv_expand_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/gray_500"
                android:rotation="0" />

        </LinearLayout>

        <!-- 可展开内容区域 -->
        <LinearLayout
            android:id="@+id/expandable_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:animateLayoutChanges="true">

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_200"
                android:layout_marginHorizontal="16dp" />

            <!-- 详细内容 -->
            <TextView
                android:id="@+id/tv_theme_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/culture_theme_4_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="21sp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/jiemianbiaoti"
                android:lineSpacingExtra="6dp"
                android:justificationMode="inter_word" />

            <!-- 第二个TextView -->
            <TextView
                android:id="@+id/tv_theme_content_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:paddingTop="8dp"
                android:text="@string/culture_theme_4_content_2"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:lineSpacingExtra="4dp"
                android:justificationMode="inter_word" />

            <!-- 第三个TextView -->
            <TextView
                android:id="@+id/tv_theme_content_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/culture_theme_4_content_3"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="21sp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/jiemianbiaoti"
                android:lineSpacingExtra="6dp"
                android:justificationMode="inter_word" />

            <!-- 第四个TextView -->
            <TextView
                android:id="@+id/tv_theme_content_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:paddingTop="8dp"
                android:text="@string/culture_theme_4_content_4"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:lineSpacingExtra="4dp"
                android:justificationMode="inter_word" />

            <!-- 第五个TextView -->
            <TextView
                android:id="@+id/tv_theme_content_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/culture_theme_4_content_5"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="21sp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/jiemianbiaoti"
                android:lineSpacingExtra="6dp"
                android:justificationMode="inter_word" />

            <!-- 第六个TextView -->
            <TextView
                android:id="@+id/tv_theme_content_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/culture_theme_4_content_6"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:lineSpacingExtra="4dp"
                android:justificationMode="inter_word" />

            <!-- 第七个TextView -->
            <TextView
                android:id="@+id/tv_theme_content_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/culture_theme_4_content_7"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="21sp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/jiemianbiaoti"
                android:lineSpacingExtra="6dp"
                android:justificationMode="inter_word" />

            <!-- 第八个TextView -->
            <TextView
                android:id="@+id/tv_theme_content_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/culture_theme_4_content_8"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:lineSpacingExtra="4dp"
                android:justificationMode="inter_word" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>