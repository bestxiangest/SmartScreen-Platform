<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_light_blue_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 顶部渐变质感标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_orange_border_light_blue"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 动态波浪线分割器 -->

            <!-- 主标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\t\t\t\t"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ai_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI智能助手"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 圆形微信小程序按钮 -->
                <LinearLayout
                    android:id="@+id/btn_wechat_miniprogram"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_wechat_circle_button"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/little_app"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="微信小程序"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>
                
            <!-- 对话状态指示器 -->
            <TextView
                android:id="@+id/tv_conversation_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍩 支持上下文对话"
                android:textSize="18sp"
                android:textColor="@color/orange_600"
                android:background="@drawable/bg_feature_tag_orange"
                android:padding="8dp"
                android:layout_gravity="center"
                android:layout_marginEnd="8dp" />

            <!-- AI原子符号水印 -->

            <ImageView
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:alpha="0.3"
                android:src="@drawable/ai_atom_watermark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="已接入DeepSeek大模型"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:alpha="0.9" />

        </LinearLayout>



    <!-- 中央核心区域 - 双层对话容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <!-- 上层：半透明消息历史展示框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_orange_border_light_blue"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 消息历史滚动容器 -->
                <ScrollView
                    android:id="@+id/messages_scroll_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="0dp"
                    android:padding="8dp"
                    android:scrollbars="none"
                    android:visibility="visible"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/messages_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 示例对话气泡 1 - 用户提问 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="60dp"
                                android:background="@drawable/bg_user_message_bubble"
                                android:elevation="2dp"
                                android:padding="12dp"
                                android:text="你好，请帮我介绍一下这个实验室的主要功能？"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- 示例对话气泡 2 - 助手回复 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="start"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="60dp"
                                android:background="@drawable/bg_assistant_message_bubble"
                                android:elevation="2dp"
                                android:padding="12dp"
                                android:text="您好！我是AI智能助手。这里是通信电子创新基地，主要功能包括：\n\n📡 通信技术研发\n🔬 电子创新实验\n👥 人才培养计划\n🎯 项目孵化支持\n\n有什么具体问题我可以为您解答？"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                        <!-- 示例对话气泡 3 - 用户提问 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="80dp"
                                android:background="@drawable/bg_user_message_bubble"
                                android:elevation="2dp"
                                android:padding="12dp"
                                android:text="能详细介绍一下AI人才培养项目吗？"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <!-- 示例对话气泡 4 - 助手回复 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="start"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="50dp"
                                android:background="@drawable/bg_assistant_message_bubble"
                                android:elevation="2dp"
                                android:padding="12dp"
                                android:text="AI人才培养项目是我们的核心特色：\n\n🎓 理论与实践结合\n💻 前沿技术学习\n🤝 导师一对一指导\n🏆 项目实战机会"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

            <!-- 下层：浮动输入控制台 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_orange_border_light_blue"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- 清空对话按钮 -->
                <ImageButton
                    android:id="@+id/btn_clear_chat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_clear_btn"
                    android:elevation="2dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_clear"
                    android:contentDescription="清空对话" />

                <!-- 圆形麦克风按钮 -->
                <ImageButton
                    android:id="@+id/btn_microphone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_microphone_btn"
                    android:elevation="3dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_microphone"
                    android:contentDescription="语音输入" />

                <!-- 多行文本输入框 -->
                <EditText
                    android:id="@+id/et_message_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_message_input"
                    android:hint="请输入您的问题..."
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:maxLines="3"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionSend" />

                <!-- 发送按钮 -->
                <ImageButton
                    android:id="@+id/btn_send_message"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_send_btn"
                    android:elevation="3dp"
                    android:src="@drawable/send"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:contentDescription="发送消息" />

            </LinearLayout>

    </LinearLayout>

</LinearLayout>