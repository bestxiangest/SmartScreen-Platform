<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cultivation"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶部标题区 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_title_card"
            android:padding="24dp"
            android:elevation="4dp">

            <!-- 微信小程序按钮 -->
            <ImageButton
                android:id="@+id/btn_wechat_miniprogram"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_wechat_circle_button"
                android:src="@drawable/ic_wechat_logo"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:elevation="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_toStartOf="@id/btn_wechat_miniprogram"
                android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 AI人才培养方案生成系统"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/blue_800"
                android:gravity="center"
                android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="智能化个性定制 · 精准培养路径"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

            </LinearLayout>

        </RelativeLayout>

        <!-- 中间个人信息输入区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_card"
            android:padding="24dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 个人信息填写"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="20dp" />

            <!-- 第一行：姓名和年龄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_name"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="请输入姓名"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎂"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_age"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="请输入年龄"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="number" />

                </LinearLayout>

            </LinearLayout>

            <!-- 第二行：学历和专业 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎓"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_education"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="请输入学历（如：本科、硕士）"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_major"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="请输入专业"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                </LinearLayout>

            </LinearLayout>

            <!-- 第三行：工作经验和技能水平 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💼"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_experience"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="工作经验（年）"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="number" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_skill_level"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="技能水平（初级/中级/高级）"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                </LinearLayout>

            </LinearLayout>

            <!-- 第四行：兴趣方向和学习目标 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_interest"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="兴趣方向（如：机器学习、深度学习）"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀"
                        android:textSize="20sp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_goal"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="学习目标"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 生成方案按钮 -->
        <Button
            android:id="@+id/btn_generate_plan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶️ 生成个性化培养方案"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_generate_button"
            android:layout_marginBottom="24dp"
            android:elevation="4dp" />

        <!-- 底部方案展示区 -->
        <LinearLayout
            android:id="@+id/layout_plan_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_plan_card"
            android:padding="24dp"
            android:elevation="2dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓 您的专属AI培养方案"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/bg_plan_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_plan_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点击上方按钮生成您的专属培养方案..."
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:gravity="center" />

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="end">

                <Button
                    android:id="@+id/btn_save_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="💾 保存方案"
                    android:textSize="14sp"
                    android:textColor="@color/blue_600"
                    android:background="@drawable/bg_save_button"
                    android:layout_marginEnd="12dp"
                    android:paddingHorizontal="16dp" />

                <Button
                    android:id="@+id/btn_share_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="📤 分享方案"
                    android:textSize="14sp"
                    android:textColor="@color/orange_600"
                    android:background="@drawable/bg_share_button"
                    android:paddingHorizontal="16dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>