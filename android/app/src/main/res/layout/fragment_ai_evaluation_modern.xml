<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_light_blue_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 现代化顶部标题区 - 保留原标题，风格统一 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_orange_border_light_blue"
            android:padding="32dp"
            android:layout_marginBottom="24dp"
            android:elevation="8dp">

            <!-- 主标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\t\t\t\t"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ai_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI项目评估"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\t\t\t\t\t深度学习赋能 · 智能决策引擎"
                        android:layout_gravity="center"
                        android:textSize="16sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 圆形微信小程序按钮 -->
                <LinearLayout
                    android:id="@+id/btn_wechat_miniprogram"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_wechat_circle_button"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/little_app"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="微信小程序"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 功能特色标签 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 智能分析"
                    android:textSize="18sp"
                    android:textColor="@color/blue_600"
                    android:background="@drawable/bg_feature_tag_blue"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 数据驱动"
                    android:textSize="18sp"
                    android:textColor="@color/orange_600"
                    android:background="@drawable/bg_feature_tag_orange"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 全面评估"
                    android:textSize="18sp"
                    android:textColor="@color/green_600"
                    android:background="@drawable/bg_feature_tag_green"
                    android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 现代化信息输入区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_orange_border_light_blue"
            android:padding="24dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_form_fill"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="项目信息填写"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- 现代化输入字段 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 项目名称 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="@color/blue_500"
                    app:hintTextColor="@color/blue_500"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_project_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="🏷️ 项目名称"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 项目简介 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="@color/blue_500"
                    app:hintTextColor="@color/blue_500"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_project_introduce"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="📄 项目简介"
                        android:minLines="3"
                        android:gravity="top"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 技术领域 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="@color/blue_500"
                    app:hintTextColor="@color/blue_500"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_tech_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="🔬 技术领域 (如: 人工智能, 区块链)"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 项目周期和预算并排 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:boxStrokeColor="@color/blue_500"
                        app:hintTextColor="@color/blue_500"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_project_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="⏳ 项目周期 (月)"
                            android:inputType="number"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:boxStrokeColor="@color/blue_500"
                        app:hintTextColor="@color/blue_500"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_budget_range"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="💰 预算 (万元)"
                            android:inputType="numberDecimal"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 团队规模 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/blue_500"
                    app:hintTextColor="@color/blue_500"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_team_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="👥 团队规模 (人)"
                        android:inputType="number"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 现代化操作按钮区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <!-- 主要生成按钮 -->
            <Button
                android:id="@+id/btn_start_evaluation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="启动 AI 评估"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_modern_primary_button"
                android:elevation="6dp"
                android:layout_marginBottom="12dp" />

            <!-- 生成进度条 -->
            <LinearLayout
                android:id="@+id/layout_progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/bg_feature_tag_orange"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progress_evaluation"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    style="?android:attr/progressBarStyle"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI正在为您生成专属评估报告..."
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 辅助操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_quick_fill"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="快速填写"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_modern_secondary_button"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_clear_form"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="清空表单"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_modern_tertiary_button"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 现代化方案展示区 -->
        <LinearLayout
            android:id="@+id/layout_evaluation_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_feature_tag_orange"
            android:padding="24dp"
            android:elevation="6dp"
            android:visibility="gone">

            <!-- 结果标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_success_check"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tv_evaluation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="您的专属AI评估报告"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- 方案内容展示 - 卡片式布局 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- 技术可行性分析 Card -->
                <include layout="@layout/item_cultivation_card"
                    android:id="@+id/card_tech_feasibility" />

                <!-- 商业价值评估 Card -->
                <include layout="@layout/item_cultivation_card"
                    android:id="@+id/card_business_value" />

                <!-- 创新程度分析 Card -->
                <include layout="@layout/item_cultivation_card"
                    android:id="@+id/card_innovation" />

                <!-- 实施风险评估 Card -->
                <include layout="@layout/item_cultivation_card"
                    android:id="@+id/card_risk_assessment" />

                <!-- 市场前景预测 Card -->
                <include layout="@layout/item_cultivation_card"
                    android:id="@+id/card_market_prospects" />

                <!-- 综合评估建议 Card -->
                <include layout="@layout/item_cultivation_card"
                    android:id="@+id/card_overall_suggestion" />

                <include layout="@layout/item_cultivation_card"
                    android:id="@+id/card_technical_architecture" />
            </LinearLayout>

            <!-- 生成的图片展示区域 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_feature_tag_orange">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 AI生成的评估分析图表"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"
                        android:gravity="center" />

                    <ImageView
                        android:id="@+id/iv_generated_chart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_chart_placeholder"
                        android:visibility="gone"
                        android:minHeight="200dp"
                        android:contentDescription="AI生成的评估分析图表" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 隐藏的原始内容TextView，用于保存完整内容 -->
            <TextView
                android:id="@+id/tv_evaluation_details"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- 底部操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btn_save_evaluation"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="保存报告"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_modern_secondary_button"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_share_evaluation"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="分享结果"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_modern_tertiary_button"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>