<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_management_gradient"
    android:padding="16dp"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 页面标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cultivation_title"
                android:textColor="@color/text_primary"
                android:textSize="38sp"
                android:textStyle="bold"
                android:fontFamily="@font/jiemianbiaoti"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="培养创新人才，构建完善的人才培养体系"
                android:textColor="@color/text_muted"
                android:textSize="20sp"
                android:fontFamily="@font/jiemianxiaozi" />

        </LinearLayout>

        <!-- 培养人才目标板块 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_cultivation_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_orange_border_light_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:minHeight="220dp">

                <!-- 文字区域 (60%宽度) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cultivation_goal_title"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="#2C5F9D"
                        android:fontFamily="@font/alimama"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cultivation_goal_description"
                        android:textSize="18sp"
                        android:textColor="#333333"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4dp"
                        android:justificationMode="inter_word" />

                </LinearLayout>

                <!-- 图片区域 (40%宽度) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/img_cultivation_goal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/cultivation_goal_image_desc"
                        android:transitionName="cultivation_goal_image" />

                </FrameLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 培养方向板块标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cultivation_direction_title"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#2C5F9D"
            android:fontFamily="@font/alimama"
            android:layout_marginBottom="16dp" />

        <!-- 培养方向双卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:baselineAligned="false">

            <!-- 左卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_cultivation_direction_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_orange_border_light_blue">

                    <!-- 图片容器 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_marginBottom="12dp"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/img_cultivation_direction_1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/cultivation_direction_theory_image_desc"
                            android:transitionName="cultivation_direction_1_image" />

                    </FrameLayout>

                    <!-- 文字描述区 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cultivation_direction_theory_title"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#2C5F9D"
                                android:fontFamily="@font/alimama"
                                android:layout_marginBottom="8dp" />

                        <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cultivation_direction_theory_description"
                                android:textSize="18sp"
                                android:textColor="#333333"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 右卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_cultivation_direction_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_orange_border_light_blue">

                    <!-- 图片容器 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="508dp"
                        android:layout_marginBottom="12dp"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/img_cultivation_direction_2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/cultivation_direction_practice_image_desc"
                            android:transitionName="cultivation_direction_2_image" />

                    </FrameLayout>

                    <!-- 文字描述区 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cultivation_direction_practice_title"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#2C5F9D"
                                android:fontFamily="@font/alimama"
                                android:layout_marginBottom="8dp" />

                        <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cultivation_direction_practice_description"
                                android:textSize="18sp"
                                android:textColor="#333333"
                                android:fontFamily="sans-serif"
                                android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- 底部间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>