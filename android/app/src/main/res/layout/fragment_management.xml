                        android:alpha="0.87" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 基地资料与材料设备管理办法 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_resource_management"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
