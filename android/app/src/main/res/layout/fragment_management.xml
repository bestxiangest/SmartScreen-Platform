                        android:textColor="@color/black"
                        android:textSize="19sp"
                        android:lineSpacingExtra="8dp"
                        android:alpha="0.87" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 基地成员管理办法 -->
