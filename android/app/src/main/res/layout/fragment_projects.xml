<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_light_blue_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_orange_border_light_blue">

        <!-- 页面标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/projects_title"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="0dp"
                android:fontFamily="@font/jiemianbiaoti"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/projects_subtitle"
                android:textSize="18sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/jiemianxiaozi"
                android:alpha="0.8"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- 项目统计概览 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <!-- 项目总数 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stats_card_blue"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42"
                    android:textSize="28sp"
                    android:fontWeight="800"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_projects"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:alpha="0.9" />

            </LinearLayout>

            <!-- 获奖项目 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stats_card_purple"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textSize="28sp"
                    android:fontWeight="800"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/awarded_projects"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:alpha="0.9" />

            </LinearLayout>

            <!-- 专利申请 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stats_card_green"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28"
                    android:textSize="28sp"
                    android:fontWeight="800"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/patent_applications"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:alpha="0.9" />

            </LinearLayout>

            <!-- 产业化 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stats_card_orange"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="28sp"
                    android:fontWeight="800"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/industrialized"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:alpha="0.9" />

            </LinearLayout>

        </LinearLayout>

        <!-- 获奖项目 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_light_blue_background"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/awarded_projects"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/jiemianbiaoti"
                android:gravity="center"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.01" />

            <!-- 获奖项目网格布局 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 第一行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- 项目1 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/project_card_1"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:elevation="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="@color/purple_500"
                        app:strokeWidth="2dp"
                        app:strokeColor="#FFD700">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <!-- 查看详细按钮 -->
                            <ImageButton
                                android:id="@+id/btn_detail_1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_detail_button"
                                android:src="@drawable/ic_arrow_forward"
                                android:contentDescription="查看详细"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                android:elevation="2dp" />

                            <!-- 项目信息 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginEnd="30dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="基于物联网技术的智慧蔬菜大棚监测系统"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="10dp"
                                    android:letterSpacing="0.01" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="第16届中国大学生计算机设计大赛江西省二等奖"
                                    android:textSize="14sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:padding="6dp"
                                    android:alpha="0.95" />

                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 项目2 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/project_card_2"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:elevation="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="@color/blue_500"
                        app:strokeWidth="2dp"
                        app:strokeColor="#FFD700">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <!-- 查看详细按钮 -->
                            <ImageButton
                                android:id="@+id/btn_detail_2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_detail_button"
                                android:src="@drawable/ic_arrow_forward"
                                android:contentDescription="查看详细"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                android:elevation="2dp" />

                            <!-- 项目信息 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginEnd="30dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="点滴卫士——智慧输液报警系统"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="10dp"
                                    android:letterSpacing="0.01" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="第18届iCAN大学生创新创业大赛江西赛区二等奖"
                                    android:textSize="14sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:padding="6dp"
                                    android:alpha="0.95" />

                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 项目3 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/project_card_3"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:elevation="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="@color/green_500"
                        app:strokeWidth="2dp"
                        app:strokeColor="#FFD700">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <!-- 查看详细按钮 -->
                            <ImageButton
                                android:id="@+id/btn_detail_3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_detail_button"
                                android:src="@drawable/ic_arrow_forward"
                                android:contentDescription="查看详细"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                android:elevation="2dp" />

                            <!-- 项目信息 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginEnd="30dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="术影无踪——OpenCV双目视觉智能手术调光系统"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="10dp"
                                    android:letterSpacing="0.01" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="第17届中国大学生计算机设计大赛江西省二等奖"
                                    android:textSize="14sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:padding="6dp"
                                    android:alpha="0.95" />

                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- 第二行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 项目4 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/project_card_4"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:elevation="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="@color/orange_500"
                        app:strokeWidth="2dp"
                        app:strokeColor="#FFD700">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <!-- 查看详细按钮 -->
                            <ImageButton
                                android:id="@+id/btn_detail_4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_detail_button"
                                android:src="@drawable/ic_arrow_forward"
                                android:contentDescription="查看详细"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                android:elevation="2dp" />

                            <!-- 项目信息 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginEnd="30dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="光明之路——一种”开源节流“型路灯"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="8dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="第18届iCAN大学生创新创业大赛江西赛区二等奖"
                                    android:textSize="16sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:padding="4dp"
                                    android:maxLines="2"
                                    android:ellipsize="end" />

                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 项目5 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/project_card_5"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:elevation="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="@color/teal_500"
                        app:strokeWidth="2dp"
                        app:strokeColor="#FFD700">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <!-- 查看详细按钮 -->
                            <ImageButton
                                android:id="@+id/btn_detail_5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_detail_button"
                                android:src="@drawable/ic_arrow_forward"
                                android:contentDescription="查看详细"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                android:elevation="2dp" />

                            <!-- 项目信息 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginEnd="30dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="声纹哨兵——城市噪声污染AI监测与治理系统"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="8dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="第17届中国大学生计算机设计大赛江西省二等奖"
                                    android:textSize="16sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:padding="4dp"
                                    android:maxLines="2"
                                    android:ellipsize="end" />

                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 项目6 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/project_card_6"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:elevation="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardBackgroundColor="@color/indigo_500"
                        app:strokeWidth="2dp"
                        app:strokeColor="#FFD700">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <!-- 查看详细按钮 -->
                            <ImageButton
                                android:id="@+id/btn_detail_6"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_detail_button"
                                android:src="@drawable/ic_arrow_forward"
                                android:contentDescription="查看详细"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                android:elevation="2dp" />

                            <!-- 项目信息 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginEnd="30dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="聆途睿行一一基于多模态人机交互的智慧导盲系统"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:layout_marginBottom="8dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="2024年互联网+大学生创新创业大赛金奖"
                                    android:textSize="16sp"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:padding="4dp"
                                    android:maxLines="2"
                                    android:ellipsize="end" />

                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 发明专利和计算机软著 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- 发明专利板块 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_light_blue_background"
                android:padding="24dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="发明专利"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/alimama"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- 专利列表 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 专利图片1 -->
                     <View
                         android:layout_width="match_parent"
                         android:layout_height="120dp"
                         android:background="#FF6B6B"
                         android:layout_marginBottom="12dp" />

                     <!-- 专利图片2 -->
                     <View
                         android:layout_width="match_parent"
                         android:layout_height="120dp"
                         android:background="#4ECDC4"
                         android:layout_marginBottom="12dp" />

                     <!-- 专利图片3 -->
                     <View
                         android:layout_width="match_parent"
                         android:layout_height="120dp"
                         android:background="#45B7D1" />

                </LinearLayout>

            </LinearLayout>

            <!-- 计算机软著板块 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_light_blue_background"
                android:padding="24dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="计算机软著"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/alimama"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- 软著列表 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 软著图片1 -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1090dp"
                        android:src="@drawable/ruanzhu1"
                        android:scaleType="fitXY"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="软件著作权证书1" />

                    <!-- 软著图片2 -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="1090dp"
                        android:src="@drawable/ruanzhu2"
                        android:scaleType="fitXY"
                        android:contentDescription="软件著作权证书2" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>