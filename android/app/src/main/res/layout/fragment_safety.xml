                            android:textSize="18sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 提醒5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_orange_border_light_blue"
                    android:padding="12dp"
                    android:layout_marginBottom="9dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/dis_allow"
                            android:layout_marginEnd="8dp"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="严禁在实验室内进行与实验无关的活动，确保实验环境安全有序"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 提醒6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_orange_border_light_blue"
                    android:padding="12dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/emergency_contact"
                            android:layout_marginEnd="8dp"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="如果遇到紧急情况请立即通知实验室负责人或安全管理员"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            </LinearLayout>

            <!-- 右侧：安全操作指南 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 电气安全 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_orange_border_light_blue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <!-- 左侧：电气安全大标题区域 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@color/blue_500"
                        android:padding="8dp">

                        <!-- 电气图标 -->
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/electrical_safety"
                            android:layout_marginBottom="8dp"
                            android:scaleType="centerCrop" />

                        <!-- 主标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="电气安全"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="@font/alimama" />

                        <!-- 装饰线条 -->
                        <View
                            android:layout_width="30dp"
                            android:layout_height="2dp"
                            android:background="@android:color/white"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <!-- 右侧：安全细则 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <!-- 细则标题 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📋 操作规范"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/alimama" />

                        <!-- 规则1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_orange_border_light_blue"
                            android:padding="8dp"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/blue_500"
                                android:background="@drawable/bg_light_blue_background"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:minWidth="20dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="使用电气设备前检查线路完整性"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                        <!-- 规则2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_orange_border_light_blue"
                            android:padding="8dp"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/blue_500"
                                android:background="@drawable/bg_light_blue_background"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:minWidth="20dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="湿手禁止触摸电气开关"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                        <!-- 规则3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_orange_border_light_blue"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/blue_500"
                                android:background="@drawable/bg_light_blue_background"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:minWidth="20dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="发现电气故障立即断电报告"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                    </LinearLayout>

            </LinearLayout>

                <!-- 电子器件安全 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_orange_border_light_blue"
                    android:padding="12dp">

                    <!-- 左侧：电子器件安全大标题区域 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@color/green_500"
                        android:padding="8dp">

                        <!-- 电子器件图标 -->
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/electrical_device_safety"
                            android:layout_marginBottom="8dp"
                            android:scaleType="centerCrop" />

                        <!-- 主标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="电子器件安全"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="@font/alimama" />

                        <!-- 装饰线条 -->
                        <View
                            android:layout_width="30dp"
                            android:layout_height="2dp"
                            android:background="@android:color/white"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <!-- 右侧：安全细则 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <!-- 细则标题 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🛡️ 防护要求"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/alimama" />

                        <!-- 规则1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_orange_border_light_blue"
                            android:padding="8dp"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/green_500"
                                android:background="@drawable/bg_light_blue_background"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:minWidth="20dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="使用电子元器件前检查规格参数"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                        <!-- 规则2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_orange_border_light_blue"
                            android:padding="8dp"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="B"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/green_500"
                                android:background="@drawable/bg_light_blue_background"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:minWidth="20dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="静电敏感器件需佩戴防静电手环"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                        <!-- 规则3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_orange_border_light_blue"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="C"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/green_500"
                                android:background="@drawable/bg_light_blue_background"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:minWidth="20dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="焊接作业必须在通风良好环境下进行"
