                    android:padding="32dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- 消息头部（收缩状态显示） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <!-- 标签区域 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            
                            <!-- 今日消息标签 -->
                            <TextView
                                android:id="@+id/tag_today_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="今日消息"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_tag_blue"
                                android:padding="6dp"
                                android:layout_marginEnd="8dp"
                                android:visibility="visible" />
                            
                            <!-- 重要消息标签 -->
                            <TextView
                                android:id="@+id/tag_important_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="重要消息"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_tag_orange"
                                android:padding="6dp"
                                android:layout_marginEnd="8dp"
                                android:visibility="visible" />
                            
                            <!-- 消息类型标签 -->
                            <TextView
                                android:id="@+id/tag_type_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="安全培训"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_tag_green"
                                android:padding="6dp" />
                                
                        </LinearLayout>
                        
                        <!-- 消息内容区域 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- 消息标题 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/title_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="实验室安全培训通知"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/time_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2023-12-15 09:30"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                            <!-- 展开/收起按钮 -->
                            <Button
                                android:id="@+id/btn_expand_1"
                                android:layout_width="120dp"
                                android:layout_height="36dp"
                                android:text="展开详细内容"
                                android:textSize="16sp"
                                android:textColor="@color/primary_blue"
                                android:background="@android:color/transparent"
                                android:padding="4dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp" />

                        </LinearLayout>
                        
