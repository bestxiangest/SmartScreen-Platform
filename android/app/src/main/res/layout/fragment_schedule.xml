                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <!-- 标签区域 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            
                            <!-- 今日消息标签 -->
                            <TextView
                                android:id="@+id/tag_today_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="今日消息"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_tag_blue"
                                android:padding="6dp"
                                android:layout_marginEnd="8dp"
                                android:visibility="visible" />
                            
                            <!-- 重要消息标签 -->
                            <TextView
                                android:id="@+id/tag_important_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="重要消息"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_tag_orange"
                                android:padding="6dp"
                                android:layout_marginEnd="8dp"
                                android:visibility="visible" />
                            
                            <!-- 消息类型标签 -->
                            <TextView
                                android:id="@+id/tag_type_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="设备通知"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_tag_green"
                                android:padding="6dp" />
                                
                        </LinearLayout>
                        
                        <!-- 消息内容区域 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- 消息标题 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/title_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="新设备到货通知"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/time_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2023-12-13 10:15"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                            <!-- 展开/收起按钮 -->
                            <Button
                                android:id="@+id/btn_expand_5"
                                android:layout_width="120dp"
                                android:layout_height="36dp"
                                android:text="展开详细内容"
                                android:textSize="16sp"
                                android:textColor="@color/primary_blue"
                                android:background="@android:color/transparent"
                                android:padding="4dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 消息详细内容（展开状态显示） -->
                    <LinearLayout
                        android:id="@+id/message_detail_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/content_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="新一代FPGA开发板已到货，欢迎预约使用。本批设备为最新型号，具备更强的处理能力和更丰富的接口资源。设备已完成验收并投入使用，可通过设备管理系统进行预约。"
                            android:textSize="14sp"
                            android:textColor="@color/text_muted"
                            android:lineSpacingExtra="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 分页控件 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:padding="16dp">

            <!-- 上一页按钮 -->
            <Button
                android:id="@+id/btn_prev_page"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="上一页"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary"
                android:layout_marginEnd="16dp"
                android:enabled="false" />

            <!-- 页码显示 -->
            <TextView
                android:id="@+id/tv_page_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第 1 页 / 共 2 页"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginHorizontal="16dp" />

            <!-- 下一页按钮 -->
            <Button
                android:id="@+id/btn_next_page"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="下一页"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary"
                android:layout_marginStart="16dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>